# Set these as Netlify environment variables (or in .env for `netlify dev`). Never commit real values.

# Shared password the dashboard pages send as the x-dashboard-key header
DASHBOARD_PASSWORD=change-me
# Airtable personal access token with read/write access to the jobs table
AIRTABLE_TOKEN=your-airtable-token
# Airtable base ID (starts with "app")
AIRTABLE_BASE_ID=appYourBaseId
# Airtable table the scraper writes to
AIRTABLE_TABLE_NAME=Jobs

# Google service account email (the sheet must be shared with this address)
GOOGLE_SERVICE_ACCOUNT_EMAIL=tracker-bot@your-project.iam.gserviceaccount.com
# Service account private key, with newlines escaped as \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR-KEY-HERE\n-----END PRIVATE KEY-----\n"
# ID of the Google Sheet holding the application tracker (from its URL)
GOOGLE_SHEET_ID=your-google-sheet-id

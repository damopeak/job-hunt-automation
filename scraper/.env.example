# Copy to .env and fill in. Never commit the real .env.

# Airtable personal access token with data.records:read/write on the jobs base
AIRTABLE_TOKEN=your-airtable-token
# Airtable base ID (starts with "app")
AIRTABLE_BASE_ID=appYourBaseId
# Airtable table that holds scraped jobs
AIRTABLE_TABLE_NAME=Jobs

# Reed.co.uk API key (optional; the Reed scraper is skipped if blank)
REED_API_KEY=your-reed-api-key
# Adzuna app ID (optional; Adzuna is skipped if this or the key is blank)
ADZUNA_APP_ID=your-adzuna-app-id
# Adzuna app key
ADZUNA_APP_KEY=your-adzuna-app-key

# Anthropic API key for the optional second-pass AI qualification check
ANTHROPIC_API_KEY=your-anthropic-api-key
# Set to true to enable the AI qualification check (off by default to avoid API costs)
ENABLE_AI_CHECK=false

# Path to the candidate profile JSON (defaults to profile.json, then profile.example.json)
PROFILE_PATH=profile.json
# Hours between scrape cycles when main.py is left running
RUN_INTERVAL_HOURS=3
